<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows fill the screen. No desktop menu and no shortcuts, so the browser only ever reaches the app. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <desktops>
    <number>1</number>
  </desktops>
  <theme>
    <titleLayout>C</titleLayout>
  </theme>
  <keyboard/>
  <mouse>
    <dragThreshold>4</dragThreshold>
    <!-- "Client" passes the click on to the app. A plain click bound on "Frame" would swallow it. -->
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>
  </mouse>
  <applications>
    <application type="normal">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
